{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "noEmit": true
  },
  "include": [".astro/types.d.ts", "worker-configuration.d.ts", "src/**/*", "tests/**/*", "scripts/**/*", "astro.config.mjs"],
  "exclude": ["node_modules", "dist", "app", "lib", "components", "types", "sql", "middleware.ts", "next.config.ts"]
}
