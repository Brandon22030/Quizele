{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizdeszeles",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 3 * * *"] },

  // Niveau supérieur = développement local uniquement : valeurs factices, aucun secret réel.
  // Les identifiants A_REMPLACER (ou a-remplacer-*, imposé par le format des noms R2) sont fournis par QZ-002-21.
  // Les environnements nommés n'héritent ni des bindings ni des vars, d'où la répétition.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizdeszeles-local",
      "database_id": "A_REMPLACER",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "quizdeszeles-media-local" }],
  "durable_objects": {
    "bindings": [{ "name": "GAME_SESSION", "class_name": "GameSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameSession"] }],
  "vars": {
    "BETTER_AUTH_SECRET": "factice-local-better-auth-secret-32-caracteres-minimum",
    "BETTER_AUTH_URL": "http://localhost:4321",
    "PLAYER_TOKEN_SECRET": "factice-local-player-token-secret-32-caracteres-minimum",
    "RESEND_API_KEY": "",
    "MAIL_FROM": "Quizdeszeles <local@example.invalid>",
    "MAIL_TRANSPORT": "console",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": ""
  },

  "env": {
    "preview": {
      "name": "quizdeszeles-preview",
      "triggers": { "crons": ["0 3 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "quizdeszeles-preview",
          "database_id": "A_REMPLACER",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "a-remplacer-media-preview" }],
      "durable_objects": {
        "bindings": [{ "name": "GAME_SESSION", "class_name": "GameSession" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameSession"] }],
      "vars": {
        "BETTER_AUTH_URL": "A_REMPLACER",
        "MAIL_FROM": "A_REMPLACER",
        "MAIL_TRANSPORT": "resend",
        "GOOGLE_CLIENT_ID": ""
      }
    },
    "production": {
      "name": "quizdeszeles",
      "triggers": { "crons": ["0 3 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "quizdeszeles-production",
          "database_id": "A_REMPLACER",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "a-remplacer-media-production" }],
      "durable_objects": {
        "bindings": [{ "name": "GAME_SESSION", "class_name": "GameSession" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameSession"] }],
      "vars": {
        "BETTER_AUTH_URL": "A_REMPLACER",
        "MAIL_FROM": "A_REMPLACER",
        "MAIL_TRANSPORT": "resend",
        "GOOGLE_CLIENT_ID": ""
      }
    }
  }
}
